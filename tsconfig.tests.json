{
	"$schema": "https://json.schemastore.org/tsconfig",
	// Type-checks the Vitest suites and their support files with the app's compiler options. Tests
	// import `vitest` explicitly (no globals); browser suites reach the DOM through the shared DOM lib.
	// `nuxt typecheck` generates `.nuxt/` first, so run this after it (see the `typecheck` script).
	"extends": "./.nuxt/tsconfig.json",
	"compilerOptions": {
		"types": ["node"]
	},
	"include": ["tests/**/*.ts", ".nuxt/nuxt.node.d.ts"],
	// These suites are the only importers of two source modules with their own type errors
	// (src/application/services/canonical-resources.ts, src/preview/protocol/contour-cache.ts),
	// which `nuxt typecheck` never reaches. Drop them from this list once those modules are fixed.
	"exclude": [
		"tests/application-foundation.test.ts",
		"tests/i18n-assets.test.ts",
		"tests/preview-contour-cache.test.ts"
	]
}

{
	"$schema": "https://json.schemastore.org/tsconfig",
	// Type-checks the Vitest suites and their support files with the app's compiler options. Tests
	// import `vitest` explicitly (no globals); browser suites reach the DOM through the shared DOM lib.
	// The `typecheck:tests` script runs `nuxt prepare` first to generate `.nuxt/`. `noEmit` is set
	// here too, so a run without `.nuxt/` fails without writing `.js` files next to the sources.
	"extends": "./.nuxt/tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["tests/**/*.ts", ".nuxt/nuxt.node.d.ts"]
}

id":"empty-start","type":"Button"}]},"type":"EmptyState"}]},"type":"Stack"},{"config":{"align":"end","direction":"vertical","gap":8,"justify":"end","overlay":true,"padding":16},"id":"tray","slots":{"content":[{"config":{"direction":"vertical","maxWidth":"100%","visible":false,"width":"360px"},"id":"toast-unsupported-wrap","slots":{"content":[{"config":{"icon":"info","title":{"$i18n":"commentBlock.unsupported"},"toast":true,"tone":"info"},"id":"toast-unsupported","type":"Alert"}]},"type":"Stack"},{"config":{"direction":"vertical","maxWidth":"100%","visible":false,"width":"360px"},"id":"toast-signed-out-wrap","slots":{"content":[{"config":{"icon":"info","title":{"$i18n":"commentBlock.signed-out"},"toast":true,"tone":"info"},"id":"toast-signed-out","type":"Alert"}]},"type":"Stack"},{"config":{"direction":"vertical","maxWidth":"100%","visible":false,"width":"360px"},"id":"toast-key-wrap","slots":{"content":[{"config":{"icon":"info","title":{"$i18n":"commentBlock.key"},"toast":true,"tone":"info","value":"reviews.write"},"id":"toast-key","type":"Alert"}]},"type":"Stack"},{"config":{"direction":"vertical","maxWidth":"100%","visible":false,"width":"360px"},"id":"toast-handset-wrap","slots":{"content":[{"config":{"icon":"info","title":{"$i18n":"commentBlock.handset"},"toast":true,"tone":"info"},"id":"toast-handset","type":"Alert"}]},"type":"Stack"},{"config":{"direction":"vertical","maxWidth":"100%","visible":false,"width":"360px"},"id":"toast-no-view-wrap","slots":{"content":[{"config":{"icon":"info","title":{"$i18n":"commentBlock.no-view"},"toast":true,"tone":"info"},"id":"toast-no-view","type":"Alert"}]},"type":"Stack"},{"config":{"direction":"vertical","maxWidth":"100%","visible":false,"width":"360px"},"id":"toast-connecting-wrap","slots":{"content":[{"config":{"icon":"info","title":{"$i18n":"commentBlock.connecting"},"toast":true,"tone":"info"},"id":"toast-connecting","type":"Alert"}]},"type":"Stack"},{"config":{"direction":"vertical","maxWidth":"100%","visible":false,"width":"360px"},"id":"toast-reconnecting-wrap","slots":{"content":[{"config":{"icon":"info","title":{"$i18n":"commentBlock.reconnecting"},"toast":true,"tone":"info"},"id":"toast-reconnecting","type":"Alert"}]},"type":"Stack"},{"config":{"direction":"vertical","maxWidth":"100%","visible":false,"width":"360px"},"id":"toast-stopped-wrap","slots":{"content":[{"config":{"icon":"info","title":{"$i18n":"commentBlock.stopped"},"toast":true,"tone":"info"},"id":"toast-stopped","type":"Alert"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"RootShell"},"name":"Comment unavailable","spec":{"accessibility":["A blocked control is aria-disabled and described by its reason, not hidden; the toast is announced as a status, and the same words are announced when a key or the palette was used."],"constraints":["Built only from Adapter Widgets (Stack, Text, Button, Segment, SegmentedControl, EmptyState, Alert); no Widget outside the Adapter catalog.","The disabled look and the toast are shown by one Variant each; the toast is an Alert in the toast look without the placement and timing of the real one, and the tooltip of the disabled control is not modelled. The canvas Comment tool of the pill cannot be shown disabled (a Segment has no disabled state, #399).","The strings of the app are copied under the same Locale keys; the key name binds through value.","Every visible string is bound with $i18n; en-US and zh-TW keep identical key sets.","Visual language follows the Quiet Canvas design system in DESIGN.md."],"decisions":[],"entryConditions":["A member looks at the Comments tab of a View, or presses the Comment tool, the C key, the command palette entry or Comment on View while commenting is not possible.","The base state is the tab of a View without threads, for a member who may comment: Comment on View and Start commenting are available and no toast shows. Each Variant is one reason.","The render context selects one Workspace viewport preset, one Locale and one theme; the tab and the toast are Workbench chrome, so their text follows the Workbench language and is baked here per Locale."],"intent":"Show what the Workbench says when a new comment cannot be started, as built from Adapter Widgets only: the Comment on View button of the Comments tab, shown disabled, and the toast that says why when it is used anyway. No entry point to commenting disappears or does nothing silently.","interactionRules":["A blocked entry point stays visible, looks disabled and carries its reason as a tooltip and as its description for assistive technology; used anyway (a click, a key, the palette), it replaces the previous such toast with the reason.","The reasons, in the order a person can fix them: the Workspace is read-only because its schema is not supported; the member is not signed in; the member lacks the permission key to write Reviews; the device is a phone, where threads are read, replied to and triaged but never started; no View is open; the Preview is connecting, reconnecting, or stopped (the Comment tool and the C key need a live Preview, Comment on View does not).","Replying, resolving and reopening have their own rules; this is only about creating a thread."],"references":[{"label":"Phase 5 of the closed loop: dogfood coverage of the core surfaces","relation":"decision","type":"external","uri":"https://github.com/DevilTea/uiux/discussions/379#discussioncomment-19257377"},{"relation":"sibling","type":"view","viewId":"c6c0a101-7b3e-4d19-8a26-3e9d1c0b6a01"},{"relation":"sibling","type":"view","viewId":"c5f2a101-7b3e-4d19-8a26-3e9d1c0b5f01"}],"requirements":[]},"variants":{"no-view":{"state":{"comment-on-view":{"disabled":true},"empty-start":{"disabled":true},"toast-no-view-wrap":{"visible":true}}},"permission-key":{"state":{"comment-on-view":{"disabled":true},"empty-start":{"disabled":true},"toast-key-wrap":{"visible":true}}},"phone":{"requirements":["01a116f0-90e2-7a5a-b9d8-c80984d034ea"],"state":{"comment-on-view":{"disabled":true},"empty-start":{"disabled":true},"toast-handset-wrap":{"visible":true}}},"preview-connecting":{"state":{"comment-on-view":{"disabled":true},"empty-start":{"disabled":true},"toast-connecting-wrap":{"visible":true}}},"preview-reconnecting":{"state":{"comment-on-view":{"disabled":true},"empty-start":{"disabled":true},"toast-reconnecting-wrap":{"visible":true}}},"preview-stopped":{"state":{"comment-on-view":{"disabled":true},"empty-start":{"disabled":true},"toast-stopped-wrap":{"visible":true}}},"signed-out":{"state":{"comment-on-view":{"disabled":true},"empty-start":{"disabled":true},"toast-signed-out-wrap":{"visible":true}}},"workspace-unsupported":{"requirements":["01a1144e-4fcf-7b8a-8978-73b1a0cc31f4"],"state":{"comment-on-view":{"disabled":true},"empty-start":{"disabled":true},"toast-unsupported-wrap":{"visible":true}}}}}

":"semibold"},"id":"unreadable-title","type":"Text"},{"config":{"text":{"$i18n":"flowUsage.unreadableHint"},"tone":"muted","variant":"label"},"id":"unreadable-hint","type":"Text"},{"config":{"direction":"horizontal","gap":0,"justify":"start"},"id":"unreadable-link-row","slots":{"content":[{"config":{"label":{"$i18n":"panel.sample.flow_f4"},"size":"sm","variant":"link-muted"},"id":"unreadable-link","type":"Button"}]},"type":"Stack"},{"config":{"align":"baseline","direction":"horizontal","gap":4,"wrap":true},"id":"unreadable-line","slots":{"content":[{"config":{"mono":true,"text":"/steps","tone":"danger","variant":"label"},"id":"unreadable-path","type":"Text"},{"config":{"text":{"$i18n":"diagnostics.schema.expected_array"},"tone":"danger","variant":"label"},"id":"unreadable-text","type":"Text"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"RootShell"},"name":"Right panel: tabs and Flows","spec":{"accessibility":["The tab strip is a labelled group; the selected tab is marked and every tab names its content.","A Flow's steps are a labelled list; each row names the Flow and the step it opens.","A Flow with problems says so in words with its diagnostics, never by color alone."],"constraints":["Built only from Adapter Widgets (Stack, Text, Button, Badge, ListItem, SegmentedControl, Segment); no Widget outside the Adapter catalog.","The tab strip is an underline SegmentedControl; its tabs are not interactive here, the overflow of the strip scrolls sideways, and a tab without a number is not a Variant (the numbers are sample content).","The contents of the Comments, Inspect, Spec, Readiness and History tabs are Views of their own: Comments is shown by the Workbench View, Inspect by Inspector, Spec by the Spec document Views, Readiness by Readiness and History by the History Views.","Flow names, steps and Variant names are sample content; Flow names are baked samples under panel.sample.*; Flow links are Buttons in the muted link look.","Every visible string is bound with $i18n except identities (diagnostic paths, Variant names); en-US and zh-TW keep identical key sets.","Visual language follows the Quiet Canvas design system in DESIGN.md."],"decisions":[],"entryConditions":["A member selected the Flows tab of the right panel of a View in the Workbench; the panel is resizable between 300px and 440px and is shown here at 440px so that all six tabs are visible (at the default 340px the strip scrolls sideways).","The base state is the View Checkout used by two UX Flows, with three steps in all; Variants add a Flow with problems and a Flow that could not be read, or show the empty and the loading panel.","The render context selects one Workspace viewport preset, one Locale and one theme; a tablet opens the panel as a slide-over and a phone reads it full width."],"intent":"Show the right panel of a View as built from Adapter Widgets only: its tab strip (Comments, Inspect, Spec, Readiness, Flows, History, with the number of unresolved comments and of findings on their tabs) and the Flows tab, which lists the UX Flows that step through the View and the Variant each step opens.","interactionRules":["A View's page shows its Spec and Decisions, its Review threads and the UX Flows that use it; the strip switches between them, and the History tab is its own surface.","The Comments tab carries the number of unresolved threads of the View in the annotation color and the Readiness tab the number of Checks findings; a tab with none carries no number.","The Flows tab names each Flow that has a step on this View, then one row per such step with its step number and the Variant it opens, or Base state; each row opens the Flow at that step, and Flows are only read here, on every layout.","A Flow with validation problems is listed with its diagnostics, each with its path; a Flow that cannot be read at all is named apart, because whether it uses the View is unknown.","While the Flows are read the panel says so, and a View no Flow uses says so."],"references":[{"label":"Phase 5 of the closed loop: dogfood coverage of the core surfaces","relation":"decision","type":"external","uri":"https://github.com/DevilTea/uiux/discussions/379#discussioncomment-19257377"},{"relation":"opened-from","type":"view","viewId":"7f3d7780-3cb9-4e57-8f0b-2e8d569905c1"},{"relation":"flows","type":"view","viewId":"f10a5c01-3a6e-4c1d-9b0e-5d1c7e2a4f01"},{"relation":"flow-editor","type":"view","viewId":"f10a5c02-3a6e-4c1d-9b0e-5d1c7e2a4f02"},{"relation":"sibling","type":"view","viewId":"b1c7e301-4a1d-4c2e-9f31-7a4c0d2e6b01"},{"relation":"sibling","type":"view","viewId":"b1c7e303-4a1d-4c2e-9f31-7a4c0d2e6b03"},{"relation":"readiness","type":"view","viewId":"e9f5d101-3a1b-4c2d-9e4f-6b7c8d9eaf01"}],"requirements":["01a116f0-89b6-7d08-a850-e1ee1aecd51f"]},"variants":{"flow-unreadable":{"state":{"unreadable":{"visible":true}}},"flow-with-problems":{"requirements":["01a11544-629c-7dbf-8e41-36c8e37537b3"],"state":{"flow-f3":{"visible":true}}},"flows-empty":{"requirements":["01a116f0-89b6-7d08-a850-e1ee1aecd51f"],"state":{"flows-empty":{"visible":true},"flows-list":{"visible":false}}},"flows-loading":{"state":{"flows-list":{"visible":false},"flows-loading":{"visible":true}}}}}

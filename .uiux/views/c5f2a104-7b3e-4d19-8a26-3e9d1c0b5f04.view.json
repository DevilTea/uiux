ype":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"},{"config":{"label":{"$i18n":"shell.primaryNav"}},"id":"tabbar","slots":{"content":[{"config":{"icon":"layout-dashboard","label":{"$i18n":"nav.overview"},"selected":true},"id":"tab-overview","type":"TabBarItem"},{"config":{"icon":"workflow","label":{"$i18n":"nav.flows"},"selected":false},"id":"tab-flows","type":"TabBarItem"},{"config":{"icon":"inbox","label":{"$i18n":"nav.reviews"},"selected":false},"id":"tab-reviews","type":"TabBarItem"}]},"type":"TabBar"},{"config":{"align":"end","direction":"vertical","gap":8,"justify":"end","overlay":true,"padding":16},"id":"fr-toast-tray","slots":{"content":[{"config":{"direction":"vertical","maxWidth":"100%","visible":false,"width":"360px"},"id":"fr-toast-copied-wrap","slots":{"content":[{"config":{"icon":"circle-check","title":{"$i18n":"firstRun.copied"},"toast":true,"tone":"success"},"id":"fr-toast-copied","type":"Alert"}]},"type":"Stack"},{"config":{"direction":"vertical","maxWidth":"100%","visible":false,"width":"360px"},"id":"fr-toast-failed-wrap","slots":{"content":[{"config":{"icon":"circle-alert","title":{"$i18n":"firstRun.copyFailed"},"toast":true,"tone":"danger"},"id":"fr-toast-failed","type":"Alert"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"RootShell"},"name":"Overview: first run","spec":{"accessibility":["The steps are an ordered list with a heading for each; the number marks are decorative and hidden from assistive technology. The copy buttons are named \"Copy MCP endpoint\" and \"Copy command\"."],"constraints":["Built only from Adapter Widgets (Stack, Text, Button, Alert; the shell is the one of the Overview View); no Widget outside the Adapter catalog.","The endpoint, the Workspace path and the commands are identities and sample values, not translated; the strings of the app are copied under the same Locale keys, with the Widget id create_view shown as inline code through valueCode.","The toasts are Alerts in the toast look, shown by two Variants; the real toast is placed by the Workbench and disappears by itself. The steps are numbered by the Stack and Text of this View, not by an ordered list element.","The shell is the one of the Overview View: the rail lists the Workspace pages beside the three destinations and the sidebar footer and collapse button are not modelled.","Visual language follows the Quiet Canvas design system in DESIGN.md."],"decisions":[],"entryConditions":["A member opened the Overview of a Workspace with no View; once the first View exists the steps give way to the tabs of the Overview, without a reload.","The base state shows the three steps for a member who is signed in to the Workbench of a server that listens on 127.0.0.1; the MCP endpoint is the address of that server and the commands name the Workspace that the member selected.","The render context selects one Workspace viewport preset, one Locale and one theme; the Workbench chrome follows the Workbench language, so its text is baked here per Locale."],"intent":"Show the Overview of a Workspace that has no View yet, as built from Adapter Widgets only: instead of the tabs, three numbered steps that take a person from nothing to a first View: connect an agent over MCP, ask it for a View, then open it and comment.","interactionRules":["Step 1 offers one primary action, Copy MCP endpoint, and the two commands that add an agent member and create its token, each with its own copy button; a copy says \"Copied\" in a toast, and a copy the browser refuses says to select the text and copy it instead.","The agent writes Views through MCP, so nothing on this page creates one: steps 2 and 3 only tell what to ask for and what to expect.","The Overview shows no Export handoff action and no tabs while there is no View; the rest of the page is the Overview shell."],"references":[{"label":"Phase 5 of the closed loop: dogfood coverage of the core surfaces","relation":"decision","type":"external","uri":"https://github.com/DevilTea/uiux/discussions/379#discussioncomment-19257377"},{"relation":"opened-from","type":"view","viewId":"2e2f88d6-7a95-424a-b3d4-4661d811ef13"}],"requirements":["01a194f5-81a5-7b74-96b5-c4c018bae06c"]},"variants":{"copy-failed":{"state":{"fr-toast-failed-wrap":{"visible":true}}},"endpoint-copied":{"state":{"fr-toast-copied-wrap":{"visible":true}}}}}

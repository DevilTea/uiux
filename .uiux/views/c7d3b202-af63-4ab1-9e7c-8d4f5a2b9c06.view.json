justify":"end"},"id":"footer","slots":{"content":[{"config":{"label":{"$i18n":"common.cancel"},"variant":"outline"},"id":"cancel","type":"Button"},{"config":{"disabled":true,"label":{"$i18n":"access.presets.save"},"variant":"primary"},"id":"save-edit","type":"Button"},{"config":{"label":{"$i18n":"access.presets.add"},"variant":"primary","visible":false},"id":"save-add","type":"Button"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}],"header":[{"config":{"direction":"vertical","flex":"1 1 0","gap":2,"minWidth":"0px"},"id":"head","slots":{"content":[{"config":{"level":2,"text":{"$i18n":"access.presets.addTitle"},"tone":"highlighted","variant":"ui","visible":false,"weight":"semibold"},"id":"title-add","type":"Text"},{"config":{"level":2,"text":{"$i18n":"access.presets.editTitle"},"tone":"highlighted","value":"Reviewer","variant":"ui","visible":true,"weight":"semibold"},"id":"title-edit","type":"Text"},{"config":{"level":2,"text":{"$i18n":"access.presets.viewTitle"},"tone":"highlighted","value":"Reviewer","variant":"ui","visible":false,"weight":"semibold"},"id":"title-view","type":"Text"},{"config":{"text":{"$i18n":"access.presets.addDescription"},"tone":"muted","variant":"ui","visible":false},"id":"desc-add","type":"Text"},{"config":{"text":{"$i18n":"access.presets.editDescription"},"tone":"muted","variant":"ui","visible":true},"id":"desc-edit","type":"Text"},{"config":{"text":{"$i18n":"access.presets.viewDescription"},"tone":"muted","variant":"ui","visible":false},"id":"desc-view","type":"Text"}]},"type":"Stack"}]},"type":"Panel"}]},"type":"Stack"}]},"type":"RootShell"},"name":"Access presets: Add or edit a preset","spec":{"accessibility":["Keys for people only, an unknown key and a refused name or key set are said in words next to the control, never by color alone."],"constraints":["Built only from Adapter Widgets (Panel dialog, Stack, Text, TextInput, Checkbox, ListItem, Badge, Button, Alert); no Widget outside the Adapter catalog.","The drawer header is a custom header (title and description pairs, one shown per state); the drawer is a Panel dialog, centered-card styled where the real one is a flush slide-over. A Variant that shows a message below the long checklist hides the checklist.","The Start from preset menu is a dropdown the Kit has no Widget for and is not modelled. Every visible string is bound with $i18n except preset names and key identifiers; en-US and zh-TW keep identical key sets.","Visual language follows the Quiet Canvas design system in DESIGN.md."],"decisions":[],"entryConditions":["A holder of presets.manage on a desktop layout chose Add preset, Edit, or the key count of a preset on the Access presets page.","The base state is Edit for the Reviewer preset: its name and its eight keys, nothing changed yet, so Save is disabled.","The render context selects one Workspace viewport preset, one Locale and one theme; the drawer is a column on the right of a dimmed ground."],"intent":"Show the Add preset and Edit preset drawer of the Access presets page as built from Adapter Widgets only: the name of a preset and its permission key checklist, with the refusals for a taken name and equal key sets.","interactionRules":["The drawer asks for a name (up to 40 characters, shown as written) and lists the keys by domain; keys for people only are marked, and every key can be checked because a preset is not a member.","Save needs a change; a name another preset already has, or a key set another preset already has, is refused inline before saving and names the other preset.","A member without presets.manage, or on a tablet or phone, opens the preset read-only: the keys are shown, none can change and there are no buttons.","Editing a preset never changes a member's keys; only labels change. A preset removed meanwhile, or a changed presets file, refuses the save and keeps the draft."],"references":[{"label":"Phase 5 of the closed loop: dogfood coverage of the core surfaces","relation":"decision","type":"external","uri":
id":"row-captureEvidence-combo-1","slots":{"content":[{"config":{"keys":"⇧","showOnTouch":true},"id":"row-captureEvidence-combo-1-key-1","type":"Kbd"},{"config":{"keys":"⌘","showOnTouch":true},"id":"row-captureEvidence-combo-1-key-2","type":"Kbd"},{"config":{"keys":"P","showOnTouch":true},"id":"row-captureEvidence-combo-1-key-3","type":"Kbd"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"},{"config":{"align":"center","borderBottom":true,"direction":"horizontal","gap":16,"justify":"between","padding":"8px 0"},"id":"row-help","slots":{"content":[{"config":{"text":{"$i18n":"shortcuts.help"},"tone":"default","variant":"ui"},"id":"row-help-label","type":"Text"},{"config":{"align":"center","direction":"horizontal","flex":"0 1 auto","gap":6,"justify":"end","maxWidth":"55%","wrap":true},"id":"row-help-keys","slots":{"content":[{"config":{"direction":"horizontal","gap":2},"id":"row-help-combo-1","slots":{"content":[{"config":{"keys":"?","showOnTouch":true},"id":"row-help-combo-1-key-1","type":"Kbd"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Panel"}]},"type":"Stack"}]},"type":"RootShell"},"name":"Keyboard shortcuts","spec":{"accessibility":["The list is a definition list: each action is a term and its key caps are the definition; the dialog is a labelled modal with focus trapped inside."],"constraints":["Built only from Adapter Widgets (Stack, Text, Kbd, Panel dialog); no Widget outside the Adapter catalog. The key caps are Kbd with showOnTouch, so a tablet or phone shows them too.","The strings of the app are copied under the same Locale keys; the key caps are literal and never translated.","The line under the title is part of the body here, not of the dialog header, so that a Variant can swap it; the list scrolls inside a Stack and the Variant scrolled-to-end shows its end by hiding the first rows. The dialog is a Panel with a shadow over the page, not a dimmed Workbench behind a Modal.","Visual language follows the Quiet Canvas design system in DESIGN.md."],"decisions":[],"entryConditions":["A member pressed ? outside a field, or chose Keyboard shortcuts in the preferences menu or the command palette; the dialog opens centered, 512px wide, over the page.","The base state has single-key shortcuts on, so the line under the title says they are ignored while typing in a field; the list is longer than the dialog and scrolls inside it.","The render context selects one Workspace viewport preset, one Locale and one theme; the dialog is Workbench chrome and follows the Workbench language, so its text is baked here per Locale."],"intent":"Show the keyboard shortcuts dialog of the Workbench (open with ? or from the preferences menu or the command palette) as built from Adapter Widgets only: one list of what each shortcut does, with its key caps, under a line that says whether single-key shortcuts work.","interactionRules":["Each row names an action and shows its shortcut as key caps; an action with several shortcuts shows them side by side and wraps on a narrow width, so no key is ever dropped.","With single-key shortcuts off, the line under the title says so and where to turn them on (the Workbench preferences); the rows still list every shortcut, the single-key ones included.","The caps are the keys of the member's platform: ⌘ ⇧ ⌥ on a Mac, Ctrl Shift Alt elsewhere; this View shows the Mac caps.","The dialog closes with its close button or Esc, and returns focus to where it was opened from."],"references":[{"label":"Phase 5 of the closed loop: dogfood coverage of the core surfaces","relation":"decision","type":"external","uri":"https://github.com/DevilTea/uiux/discussions/379#discussioncomment-19257377"}],"requirements":[]},"variants":{"scrolled-to-end":{"state":{"row-actualSize":{"visible":false},"row-contextMenus":{"visible":false},"row-copyId":{"visible":false},"row-editSection":{"visible":false},"row-fit":{"visible":false},"row-goTo":{"visible":false},"row-landmarks":{"visible":false},"row-panelTabs":{"visible":false},"row-search":{"visible":false},"row-togglePanel":{"visible":false},"row-toggleSidebar":{"visible":false},"row-toggleTheme":{"visible":false},"row-tools":{"visible":false},"row-walkTree":{"visible":false},"row-zoom":{"visible":false}}},"single-key-off":{"state":{"desc-off":{"visible":true},"desc-on":{"visible":false}}}}}

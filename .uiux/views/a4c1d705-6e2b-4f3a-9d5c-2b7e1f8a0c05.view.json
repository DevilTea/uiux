irection":"vertical","gap":0,"visible":false},"id":"delete-wrap","slots":{"content":[{"config":{"backdrop":true,"closable":true,"closeLabel":{"$i18n":"common.close"},"maxWidth":"100%","padding":16,"title":{"$i18n":"history.delete.title"},"variant":"dialog","width":"480px"},"id":"delete-dialog","slots":{"content":[{"config":{"direction":"vertical","gap":12},"id":"delete-form","slots":{"content":[{"config":{"text":{"$i18n":"history.delete.body"},"tone":"default","value":"Before the payment redesign","variant":"ui"},"id":"delete-body","type":"Text"},{"config":{"description":{"$i18n":"history.invalid.explanation"},"icon":"info","title":{"$i18n":"history.invalid.notDeletable"},"tone":"warning","visible":false},"id":"delete-invalid-alert","type":"Alert"},{"config":{"icon":"circle-alert","title":{"$i18n":"history.delete.failed"},"tone":"danger","visible":false},"id":"delete-error-alert","type":"Alert"}]},"type":"Stack"}],"footer":[{"config":{"direction":"horizontal","gap":8,"justify":"end","wrap":true},"id":"delete-footer","slots":{"content":[{"config":{"label":{"$i18n":"common.cancel"},"variant":"outline"},"id":"delete-cancel","type":"Button"},{"config":{"icon":"trash-2","label":{"$i18n":"history.delete.confirm"},"variant":"danger"},"id":"delete-confirm","type":"Button"}]},"type":"Stack"}]},"type":"Panel"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"RootShell"},"name":"History: Checkpoint dialogs","spec":{"accessibility":["The name field is required and marked invalid with its reason in text; the lease warning names its holders in words.","The destructive action is a danger Button with a trash icon and a label."],"constraints":["Built only from Adapter Widgets (Panel dialog, Stack, Text, Icon, TextInput, Button, Alert); no Widget outside the Adapter catalog.","Every visible string is bound with $i18n except the Checkpoint name and note, member nicknames and resource names, which are Workspace content; en-US and zh-TW keep identical key sets.","The Delete dialog is opened from the Activity timeline of Overview, which is not part of this View family; the View models the dialog itself.","Visual language follows the Quiet Canvas design system in DESIGN.md."],"decisions":[],"entryConditions":["A person pressed Create Checkpoint in the History panel (tablet and desktop) as a member who holds checkpoints.create, or pressed Delete on a Checkpoint row of the Activity timeline (desktop) as a member who holds checkpoints.delete.","The base state is the Create Checkpoint dialog with a name and a note filled in; the Variants add the warnings and failures, and show the Delete dialog.","The render context selects one Workspace viewport preset, one Locale and one theme; the dialog is centered over a dimmed ground."],"intent":"Show the two Checkpoint dialogs of the Workbench as built from Adapter Widgets only: Create Checkpoint, with its name, its note and the warning about edit leases, and Delete Checkpoint, which asks for explicit confirmation.","interactionRules":["A Checkpoint saves the whole Workspace as it is now under a name of 1 to 120 characters and an optional note of up to 2,000; it needs no edit lease and changes no Workspace file.","When another member holds edit leases, the dialog warns that unfinished edits are saved too and names each holder and resource; it does not block the Checkpoint.","An empty name is named as required under the field; a failure that saved nothing says so and offers Retry; a Workspace schema this build does not support refuses the Checkpoint.","Delete Checkpoint is offered on a Checkpoint row of the Activity timeline on a desktop layout, removes only the record for everyone, can not be undone, and writes only after Delete Checkpoint is pressed; a record that cannot be read is named and is not deleted."],"references":[{"label":"Phase 5 of the closed loop: dogfood coverage of the four core surfaces","relation":"decision","type":"external","uri":"https://github.com/DevilTea/uiux/discussions/379#discussioncomment-19257377"},{"relation":"opened-from","type":"view","viewId":"a4c1d701-6e2b-4f3a-9d5c-2b7e1f8a0c01"}],"requirements":["01a11a5e-0c71-78d1-9adb-14db6c67ab9c","01a11a5e-096a-761e-a65a-6fd66e7e0b12","01a11a5e-0919-73d1-9082-cd17a275da0c"]},"variants":{"create-lease-warning":{"requirements":["01a11a5e-0cc5-7548-ab99-8894c2e0dce4","01a11a5e-0a0c-7d65-8d09-9a71a730ec61"],"state":{"lease-alert":{"visible":true},"lease-holders":{"visible":true}}},"create-name-required":{"requirements":["01a11a5e-0919-73d1-9082-cd17a275da0c"],"state":{"name-empty-field":{"visible":true},"name-field":{"visible":false}}},"create-retryable":{"state":{"create-retry-alert":{"visible":true}}},"create-schema-unsupported":{"requirements":["01a11a5e-0a5e-7562-91cd-8c48eac71529"],"state":{"create-failed-alert":{"visible":true},"create-submit":{"disabled":true}}},"create-submitting":{"state":{"create-submit":{"loading":true}}},"delete-checkpoint":{"requirements":["01a11e0d-da2f-718f-b3c3-acf2f11fb683","01a11e0d-dada-7f49-a4a0-5b45d70b23e8","01a11a5e-0c1f-7b18-83a2-d9cd62b78ae9"],"state":{"create-wrap":{"visible":false},"delete-wrap":{"visible":true}}},"delete-deleting":{"state":{"create-wrap":{"visible":false},"delete-confirm":{"loading":true},"delete-wrap":{"visible":true}}},"delete-failed":{"state":{"create-wrap":{"visible":false},"delete-error-alert":{"visible":true},"delete-wrap":{"visible":true}}},"delete-record-invalid":{"state":{"create-wrap":{"visible":false},"delete-confirm":{"visible":false},"delete-invalid-alert":{"visible":true},"delete-wrap":{"visible":true}}}}}

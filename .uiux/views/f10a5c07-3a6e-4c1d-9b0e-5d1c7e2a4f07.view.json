n":"center","direction":"horizontal","gap":8,"wrap":true},"id":"s4-head","slots":{"content":[{"config":{"text":"Reviews inbox","tone":"highlighted","truncate":true,"variant":"ui","weight":"medium"},"id":"s4-name","type":"Text"},{"config":{"label":"thread-sheet","tone":"neutral","variant":"mono"},"id":"s4-variant","type":"Badge"},{"config":{"icon":"circle-alert","label":{"$i18n":"flows.toolbar.problems.one"},"size":"sm","tone":"danger","value":1,"variant":"subtle","visible":false},"id":"s4-problems","type":"Badge"}]},"type":"Stack"}],"leading":[{"config":{"mono":true,"text":"4","tone":"subtle","variant":"label"},"id":"s4-ordinal","type":"Text"}]},"type":"ListItem"},{"config":{"direction":"vertical","gap":0,"padding":"0 0 0 44px"},"id":"s4-end","slots":{"content":[{"config":{"text":{"$i18n":"flows.inspector.noOutgoing"},"tone":"subtle","variant":"label"},"id":"s4-end-text","type":"Text"}]},"type":"Stack"}]},"type":"Stack"},{"config":{"direction":"vertical","gap":4,"padding":"12px 0","visible":false},"id":"step-5","slots":{"content":[{"config":{"interactive":true,"size":"lg"},"id":"s5-row","slots":{"content":[{"config":{"align":"center","direction":"horizontal","gap":8,"wrap":true},"id":"s5-head","slots":{"content":[{"config":{"text":"Submit for review dialog","tone":"highlighted","truncate":true,"variant":"ui","weight":"medium"},"id":"s5-name","type":"Text"},{"config":{"text":{"$i18n":"ctx.baseState"},"tone":"muted","variant":"label"},"id":"s5-base","type":"Text"},{"config":{"icon":"circle-alert","label":{"$i18n":"flows.unreachable"},"size":"sm","tone":"danger","variant":"subtle"},"id":"s5-unreachable","type":"Badge"}]},"type":"Stack"}],"leading":[{"config":{"mono":true,"text":"5","tone":"subtle","variant":"label"},"id":"s5-ordinal","type":"Text"}]},"type":"ListItem"},{"config":{"direction":"vertical","gap":0,"padding":"0 0 0 44px"},"id":"s5-end","slots":{"content":[{"config":{"text":{"$i18n":"flows.inspector.noOutgoing"},"tone":"subtle","variant":"label"},"id":"s5-end-text","type":"Text"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"RootShell"},"name":"UX Flow editor: Step list","spec":{"accessibility":["The list is an ordered list named Steps in order, and each step's transitions are a list named after the step; a transition reads \"goes to\" for assistive technology between its trigger and its target.","A problem is never conveyed by color alone: it is an icon with text or a count, and an unreachable step says so in text.","Every pressable row keeps a visible 2px primary focus outline and a 44px target on touch tiers."],"constraints":["Built only from Adapter Widgets (Stack, Text, Badge, Icon, ListItem); no Widget outside the Adapter catalog.","A Variant can only change state, so each toggled name, trigger or target is a pair of Widgets with the problem look hidden in the base state; a selected row is the ListItem's selected state.","Every visible string is bound with $i18n except identities (View, Variant and Widget names, trigger labels); en-US and zh-TW keep identical key sets.","Visual language follows the Quiet Canvas design system in DESIGN.md."],"decisions":[],"entryConditions":["A person chose List in the editor toolbar of a Flow (/flows/<flowId>) on a desktop or tablet layout, or opened the Flow on a phone, which always shows the list; on a desktop layout the list fills the editor beside the inspector.","The base state lists a four-step Flow in breadth-first order from the entry step, with nothing selected and no problems; the last step has no outgoing transition. Variants select a row, add an unreachable step and show each kind of problem.","The render context selects one Workspace viewport preset, one Locale and one theme; this View models the list only, and the existing UX Flow editor View shows it inside the editor."],"intent":"Show the ordered step list of the UX Flow editor as built from Adapter Widgets only: every step in reading order with its outgoing transitions, the parallel accessible form of the graph and the only form on a phone, with the marks for a selected row, an unreachable step and the problems a Flow can carry.","interactionRules":["Steps are numbered from the entry step in breadth-first order, and steps that cannot be reached follow in a stable order, marked Unreachable step.","A step names its View and either its Variant or the base state; a step that names no Variant targets the View in its base state.","A transition reads as its trigger, Widget and Event, then the step it goes to; a step with no outgoing transition says it ends the Flow and carries no flag.","On a desktop or tablet layout a step or a transition is one pressable row that selects it in the inspector (a slide-over on a tablet); on a phone the list is read-only.","A problem is marked in text and with an icon: a step with a missing View or Variant carries a problem count, and a transition whose trigger is repeated or whose target step is missing shows its trigger in the error color with an icon."],"references":[{"label":"Phase 5 of the closed loop: dogfood coverage of the core surfaces","relation":"decision","type":"external","uri":"https://github.com/DevilTea/uiux/discussions/379#discussioncomment-19257377"},{"relation":"opened-from","type":"view","viewId":"f10a5c02-3a6e-4c1d-9b0e-5d1c7e2a4f02"}],"requirements":["01a11544-6172-7b9f-a8d6-3412aa2f04e7","01a11544-6270-76ac-939c-2816a124d094","01a11544-6244-7a31-b37f-7f775a7d072a","01a11544-61f0-76f1-a5a0-7bfa67408df9"]},"variants":{"duplicate-trigger":{"requirements":["01a11544-61f0-76f1-a5a0-7bfa67408df9"],"state":{"s2-t2":{"visible":true},"s2-t2-problem":{"visible":true},"s2-t2-trigger":{"visible":false},"s2-t2-trigger-bad":{"visible":true}}},"missing-step-target":{"state":{"s3-t1-problem":{"visible":true},"s3-t1-target":{"visible":false},"s3-t1-target-missing":{"visible":true},"s3-t1-trigger":{"visible":false},"s3-t1-trigger-bad":{"visible":true}}},"step-selected":{"state":{"s2-row":{"selected":true}}},"transition-selected":{"state":{"s2-t1":{"selected":true}}},"unreachable-step":{"requirements":["01a11544-6244-7a31-b37f-7f775a7d072a"],"state":{"step-5":{"visible":true}}},"variant-missing":{"state":{"s4-problems":{"visible":true}}},"view-missing":{"state":{"s3-name":{"visible":false},"s3-name-missing":{"visible":true},"s3-problems":{"visible":true}}}}}

dLook":"neutral","size":"md"},"id":"language-chinese","slots":{"content":[{"config":{"text":{"$i18n":"prefs.traditionalChinese"},"tone":"highlighted","truncate":true,"variant":"ui"},"id":"language-chinese-label","type":"Text"}],"trailing":[{"config":{"name":"check","size":16,"tone":"default","visible":false},"id":"language-chinese-check","type":"Icon"}]},"type":"ListItem"}]},"type":"Stack"},{"config":{"spacing":4},"id":"sep-2","type":"Divider"},{"config":{"direction":"vertical","gap":0},"id":"extras-group","slots":{"content":[{"config":{"selectedLook":"neutral","size":"md"},"id":"single-key","slots":{"content":[{"config":{"text":{"$i18n":"prefs.singleKey"},"tone":"highlighted","truncate":true,"variant":"ui"},"id":"single-key-label","type":"Text"}],"trailing":[{"config":{"name":"check","size":16,"tone":"default","visible":true},"id":"single-key-check","type":"Icon"}]},"type":"ListItem"},{"config":{"selectedLook":"neutral","size":"md"},"id":"shortcuts","slots":{"content":[{"config":{"text":{"$i18n":"prefs.shortcuts"},"tone":"highlighted","truncate":true,"variant":"ui"},"id":"shortcuts-label","type":"Text"}],"leading":[{"config":{"name":"keyboard","size":16,"tone":"subtle"},"id":"shortcuts-icon","type":"Icon"}],"trailing":[{"config":{"keys":"?","showOnTouch":true},"id":"shortcuts-kbd","type":"Kbd"}]},"type":"ListItem"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"RootShell"},"name":"Workbench preferences","spec":{"accessibility":["The button is named \"Workbench preferences\"; each row is a checkbox item whose checked state is announced, the check is never the only sign of the choice.","The menu is reachable and operable by keyboard: arrows move, Space or Enter chooses."],"constraints":["Built only from Adapter Widgets (Stack, Text, Icon, Kbd, ListItem, Button, Divider); no Widget outside the Adapter catalog.","The menu is a floating card under the button, not a popover with a pointer; the row hover and focus looks and the closing on an outside press are not modelled. The check is shown or hidden by a Variant, the choice itself is not interactive.","The app repeats each group's hint (its menu shows the description twice, and the language hint is clipped at the menu edge); the hint is modelled once, as designed.","The names of the languages are identities and keep their own script: English and 繁體中文.","Every visible string is bound with $i18n; en-US and zh-TW keep identical key sets, the strings of the app copied under the same Locale keys.","Visual language follows the Quiet Canvas design system in DESIGN.md."],"decisions":[],"entryConditions":["A member pressed the preferences button of the top bar; the menu opens under it, aligned to the end, 288px wide.","The base state follows the system for both the theme and the language, with single-key shortcuts on: the member never chose anything.","The render context selects one Workspace viewport preset, one Locale and one theme; the menu is Workbench chrome, so its text follows the Workbench language and is baked here per Locale."],"intent":"Show the Workbench preferences menu, opened from the sliders button at the end of the top bar, as built from Adapter Widgets only: the theme and the language of the Workbench chrome, each a choice of following the system or fixing one value, then the single-key shortcuts switch and the entry that opens the keyboard shortcuts dialog.","interactionRules":["Each of the two groups shows its choice with a check at the end of the row; choosing a row applies it at once and keeps the menu open, so the next preference can be changed in the same visit.","Match system returns the language to the browser's; any other choice is kept for this browser until Match system is chosen again.","Both groups say, under their title, that they change the Workbench only: the previewed View keeps its own Locale and theme, which are chosen in the render context bar of the canvas.","Single-key shortcuts is a switch with a check while on; with it off, only the shortcuts that hold a modifier key work. Keyboard shortcuts opens the dialog that lists them."],"references":[{"label":"Phase 5 of the closed loop: dogfood coverage of the core surfaces","relation":"decision","type":"external","uri":"https://github.com/DevilTea/uiux/discussions/379#discussioncomment-19257377"}],"requirements":["01a116f0-91f8-7cb9-a9d1-58b87c1c6ce0","01a116f0-9282-7bf0-b48f-fe5bf0fcc0ac","01a116f0-930a-79a1-912c-f254ff9d8bd6"]},"variants":{"language-english":{"requirements":["01a116f0-91f8-7cb9-a9d1-58b87c1c6ce0","01a116f0-9282-7bf0-b48f-fe5bf0fcc0ac"],"state":{"language-chinese-check":{"visible":false},"language-english-check":{"visible":true},"language-system-check":{"visible":false}}},"language-traditional-chinese":{"requirements":["01a116f0-91f8-7cb9-a9d1-58b87c1c6ce0","01a116f0-9282-7bf0-b48f-fe5bf0fcc0ac"],"state":{"language-chinese-check":{"visible":true},"language-english-check":{"visible":false},"language-system-check":{"visible":false}}},"single-key-off":{"state":{"single-key-check":{"visible":false}}},"theme-dark":{"requirements":["01a116f0-930a-79a1-912c-f254ff9d8bd6"],"state":{"theme-dark-check":{"visible":true},"theme-light-check":{"visible":false},"theme-system-check":{"visible":false}}},"theme-light":{"requirements":["01a116f0-930a-79a1-912c-f254ff9d8bd6"],"state":{"theme-dark-check":{"visible":false},"theme-light-check":{"visible":true},"theme-system-check":{"visible":false}}}}}

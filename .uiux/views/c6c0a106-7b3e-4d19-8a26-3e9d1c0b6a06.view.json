variant":"primary"},"id":"life-resolve-menu","type":"Button"}]},"type":"Stack"}]},"type":"Stack"},{"config":{"direction":"horizontal","justify":"end","visible":true},"id":"hint-wrap","slots":{"content":[{"config":{"align":"end","text":{"$i18n":"comments.resolveAnswersHint"},"tone":"muted","variant":"label","weight":"normal"},"id":"hint","type":"Text"}]},"type":"Stack"},{"config":{"direction":"horizontal","justify":"end","visible":false},"id":"reopen-only","slots":{"content":[{"config":{"icon":"rotate-ccw","label":{"$i18n":"thread.reopen"},"size":"sm","variant":"outline"},"id":"reopen-only-button","type":"Button"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"RootShell"},"name":"Thread bubble: reply conflict and updates","spec":{"accessibility":["The Updated by others notice is announced politely as it appears, from a region that is always mounted; the refused-reply alert is an alert and focus returns to the reply box after Send again."],"constraints":["Built only from Adapter Widgets (Stack, Text, Button, Badge, Icon, Avatar, TextInput, Alert); no Widget outside the Adapter catalog.","Each notice or alert is shown by one Variant; the real notice sits in a live region that is always mounted, which a Widget cannot show. The status and message count of each case follow its Variant.","The strings of the app are copied under the same Locale keys; a sentence the app builds from several translated pieces (the notice title with its changes, the conflict description) is one sample string per Locale made of those strings.","Every visible string is bound with $i18n except identities (names); en-US and zh-TW keep identical key sets.","Visual language follows the Quiet Canvas design system in DESIGN.md."],"decisions":[],"entryConditions":["A reader has the bubble of an open thread open with a reply typed in the box (\"Thanks, that reads better.\"), and the thread changed on the server meanwhile, or a write was refused; the bubble re-read the thread.","The base state is the typed reply with no notice; each Variant shows one notice or alert above the thread's timeline.","The render context selects one Workspace viewport preset, one Locale and one theme; the bubble is Workbench chrome, so its text follows the Workbench language and is baked here per Locale. The names and messages are sample content."],"intent":"Show how the thread bubble says that a thread changed under a reader, as built from Adapter Widgets only: the notice above the reply box that others updated the thread while a reply was drafted, the alert when a reply was refused because the thread changed, and the alerts for a refused promotion and a failed post. Every one keeps what the reader typed.","interactionRules":["While a reply is being drafted and the thread changes, the bubble keeps the draft, re-reads, and shows Updated by others with what changed (new replies, a new status); the draft keeps replying to the thread as it was until the reader chooses Acknowledge, after which it replies to the latest.","When a reply is refused because the thread changed, the bubble keeps the reply, says what changed (the number of new replies, the status it has now, or that something else changed) and that the reply was not sent, and offers Send again, which sends the kept reply once against the new revision. Nothing is sent without that choice.","When the thread is resolved meanwhile, the alert says the reply is kept and that the thread must be reopened to send it, and offers no Send again.","A promotion refused for a conflict names what moved, the thread, the View or both, keeps the entries and asks to confirm again; a post that failed for another reason says so and keeps the text."],"references":[{"label":"Phase 5 of the closed loop: dogfood coverage of the core surfaces","relation":"decision","type":"external","uri":"https://github.com/DevilTea/uiux/discussions/379#discussioncomment-19257377"},{"relation":"sibling","type":"view","viewId":"c6c0a104-7b3e-4d19-8a26-3e9d1c0b6a04"}],"requirements":[]},"variants":{"promote-refused-both":{"requirements":["01a11544-611c-73e0-990b-c094b48b3eb6"],"state":{"cf-promote-both-wrap":{"visible":true}}},"promote-refused-thread":{"requirements":["01a11544-611c-73e0-990b-c094b48b3eb6"],"state":{"cf-promote-thread-wrap":{"visible":true}}},"promote-refused-view":{"requirements":["01a11544-611c-73e0-990b-c094b48b3eb6"],"state":{"cf-promote-view-wrap":{"visible":true}}},"reply-failed":{"state":{"err-reply-wrap":{"visible":true}}},"reply-refused-new-replies":{"requirements":["01a116f0-95fc-77c6-a7ab-1318cb6d19af","01a11485-f451-72eb-81ad-686aeec7b3eb"],"state":{"cf-replies-wrap":{"visible":true},"m3":{"visible":true}}},"reply-refused-other-change":{"requirements":["01a116f0-95fc-77c6-a7ab-1318cb6d19af","01a11485-f451-72eb-81ad-686aeec7b3eb"],"state":{"cf-changed-wrap":{"visible":true}}},"reply-refused-resolved":{"requirements":["01a116f0-95fc-77c6-a7ab-1318cb6d19af","01a11485-f451-72eb-81ad-686aeec7b3eb"],"state":{"cf-resolved-wrap":{"visible":true},"h-status-open":{"visible":false},"h-status-resolved":{"visible":true},"hint-wrap":{"visible":false},"life-row":{"visible":false},"reopen-only":{"visible":true},"reply":{"visible":false}}},"reply-refused-status":{"requirements":["01a116f0-95fc-77c6-a7ab-1318cb6d19af","01a11485-f451-72eb-81ad-686aeec7b3eb"],"state":{"cf-status-wrap":{"visible":true},"h-status-open":{"visible":false},"h-status-ready":{"visible":true}}},"thread-changed":{"state":{"cf-generic-wrap":{"visible":true}}},"updated-new-replies":{"requirements":["01a11485-f434-75ed-ab0a-e321468c8407"],"state":{"m3":{"visible":true},"up-replies-wrap":{"visible":true}}},"updated-other-change":{"requirements":["01a11485-f434-75ed-ab0a-e321468c8407"],"state":{"up-generic-wrap":{"visible":true}}},"updated-replies-and-status":{"requirements":["01a11485-f434-75ed-ab0a-e321468c8407"],"state":{"h-status-open":{"visible":false},"h-status-ready":{"visible":true},"m3":{"visible":true},"up-both-wrap":{"visible":true}}},"updated-status":{"requirements":["01a11485-f434-75ed-ab0a-e321468c8407"],"state":{"h-status-open":{"visible":false},"h-status-ready":{"visible":true},"up-status-wrap":{"visible":true}}}}}

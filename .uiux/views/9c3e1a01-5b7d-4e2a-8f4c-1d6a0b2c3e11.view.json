pe":"Stack"},{"config":{"direction":"vertical","gap":0,"visible":false},"id":"overview-loading","slots":{"content":[{"config":{"direction":"vertical","gap":12},"id":"overview-loading-rows","slots":{"content":[{"config":{"height":20,"label":{"$i18n":"common.loading"},"radius":4,"width":160},"id":"skeleton-1","type":"Skeleton"},{"config":{"height":32,"label":{"$i18n":"common.loading"},"radius":6,"width":"100%"},"id":"skeleton-2","type":"Skeleton"},{"config":{"height":32,"label":{"$i18n":"common.loading"},"radius":6,"width":"66%"},"id":"skeleton-3","type":"Skeleton"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"RootShell"},"name":"Product Kit: Overview","spec":{"accessibility":["The page title is the level-1 heading and each section title a level-2 heading; the section tabs are one named tab strip with the current section selected.","Build and Adapter status are text in a badge with an icon, so state is never conveyed by color alone; a building badge spins with the motion removed under reduced motion.","The build log is a named, focusable region; the Adapter specifier and config fields keep visible focus."],"constraints":["Built only from Adapter Widgets (Stack, Text, Button, Badge, Icon, Divider, ListItem, SegmentedControl, Segment, TextInput, Disclosure, CodeBlock, Alert, EmptyState, Skeleton); no Widget outside the Adapter catalog.","Every visible string is bound with $i18n except identities (package names, specifiers, Adapter IDs, build output); en-US and zh-TW keep identical key sets.","This View models the page content only; the Workbench shell (Rail, top bar, Workspace sub-navigation) is shown by the Workbench View.","Visual language follows the Quiet Canvas design system in DESIGN.md."],"decisions":[],"entryConditions":["A person opened the Product Kit destination (/workspace/product-kit, Overview is the section without a ?section= value) from the Workspace sub-navigation of the Workbench.","The base state is the dogfood Workspace as it is: no Design System packages, a ready build, one loaded Adapter (./dist/uiux.js, uiux-reference-adapter, API 1) with no unsupported theme, for a member who holds product-kit.write, product-kit.compose and product-kit.source.read.","The render context selects one Workspace viewport preset, one Locale and one theme; the Workbench renders the live page and this View is its design reference."],"intent":"Show the Overview section of the Workbench Product Kit page as built from Adapter Widgets only: the Design System packages, the kit build with its state and log, and the ordered Adapters with their resolution, identity, API and unsupported themes, with the repair guidance an invalid Adapter set needs.","interactionRules":["The section tabs navigate between Overview, Components, Styles & themes and Files; each is one section of the same page and shows its own View.","Packages are read-only: the Workbench never installs a package, and a missing one says so and where to install it.","The build state is Building, Ready, Failed or No build; a failed build says the Preview keeps using the last good output, and the build log opens in place for a member who may read it.","A member without product-kit.source.read sees the missing key named where the log would be, and no log.","Adapters are an ordered list: add, move up or down, remove, and edit the module specifier and config; saving checks the Adapter set again and a concurrent change raises a conflict that keeps the draft.","An invalid Adapter set shows the failing Adapter, its diagnostic and a repair command to run by hand; the Workbench never runs the command."],"references":[{"label":"Phase 5 of the closed loop: dogfood coverage of the four core surfaces","relation":"decision","type":"external","uri":"https://github.com/DevilTea/uiux/discussions/379#discussioncomment-19257377"},{"relation":"opened-from","type":"view","viewId":"7f3d7780-3cb9-4e57-8f0b-2e8d569905c1"}],"requirements":["01a11bb1-b918-7cb5-b581-a3fd3f647f09","01a116f0-8a46-76bc-a29f-affaa302c44c","01a115cd-af57-781e-9493-89d037e41b06","01a115cd-ad53-7ab2-a241-3b3b34fa41aa"]},"variants":{"adapters-unsupported-theme":{"requirements":["01a11a5a-5769-721b-ad33-d068c7edeb41","01a11a5a-56e8-71c8-905a-62ed0476fd8f"],"state":{"adapter-1-themes-list-text":{"visible":true},"adapter-1-themes-none-text":{"visible":false}}},"build-log-open":{"requirements":["01a11bb1-a184-7e00-a8de-c81056ad5a35"],"state":{"log":{"open":true}}},"overview-adapters-conflict":{"requirements":["01a116f0-8a46-76bc-a29f-affaa302c44c"],"state":{"adapter-1-down":{"disabled":false},"adapter-new":{"visible":true},"adapters-conflict-alert":{"visible":true},"adapters-savebar":{"visible":true},"tab-overview":{"badgeKey":"authoring.unsavedShort"}}},"overview-adapters-invalid":{"requirements":["01a115cd-af57-781e-9493-89d037e41b06","01a115cd-ac6c-7f5b-90bb-825cd1ce2ce4","01a115cd-ac3e-7b8f-992d-323ae9eeb672","01a115cd-ae0e-7f4b-8fde-d3bd69751bce","01a115cd-af27-798a-ab5b-3e5dfde30c93"],"state":{"adapter-1-down":{"disabled":false},"adapter-2":{"visible":true},"adapters-invalid-alert":{"visible":true}}},"overview-adapters-unsaved":{"requirements":["01a116f0-8a46-76bc-a29f-affaa302c44c"],"state":{"adapter-1-down":{"disabled":false},"adapter-new":{"visible":true},"adapters-savebar":{"visible":true},"tab-overview":{"badgeKey":"authoring.unsavedShort"}}},"overview-build-building":{"state":{"build-restart":{"loading":true},"build-state-building":{"visible":true},"build-state-ready":{"visible":false},"log-building":{"visible":true},"log-ok":{"visible":false}}},"overview-build-failed":{"requirements":["01a11bb1-9e5e-79ab-841e-c953e8b44bbf"],"state":{"build-state-failed":{"visible":true},"build-state-ready":{"visible":false},"log":{"open":true},"log-failed":{"visible":true},"log-ok":{"visible":false}}},"overview-kit-unreadable":{"state":{"kit-unavailable-alert":{"visible":true},"packages":{"visible":false}}},"overview-loading":{"state":{"overview-body":{"visible":false},"overview-loading":{"visible":true}}},"overview-no-read-key":{"requirements":["01a11bb1-a184-7e00-a8de-c81056ad5a35"],"state":{"log-no-key":{"visible":true},"log-wrap":{"visible":false}}},"packages-listed":{"state":{"packages-empty":{"visible":false},"packages-list-wrap":{"visible":true},"packages-missing-help-text":{"visible":true}}}}}

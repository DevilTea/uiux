s"},"id":"inspector-transition-target-opt-2","type":"SelectOption"},{"config":{"label":"3. Reviews inbox","selected":true},"id":"inspector-transition-target-opt-3","type":"SelectOption"},{"config":{"label":"4. Reviews inbox"},"id":"inspector-transition-target-opt-4","type":"SelectOption"}]},"type":"Select"},{"config":{"direction":"horizontal","gap":8},"id":"inspector-transition-actions","slots":{"content":[{"config":{"icon":"arrow-right","label":{"$i18n":"flows.inspector.selectTarget"},"size":"sm","variant":"outline"},"id":"inspector-transition-select-target","type":"Button"}]},"type":"Stack"}]},"type":"Stack"},{"config":{"align":"start","borderTop":true,"direction":"vertical","gap":8,"padding":"16px 12px"},"id":"inspector-transition-remove","slots":{"content":[{"config":{"icon":"trash-2","label":{"$i18n":"flows.inspector.removeTransition"},"size":"sm","variant":"ghost"},"id":"inspector-transition-remove-transition","type":"Button"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"Stack"}]},"type":"RootShell"},"name":"UX Flow editor","spec":{"accessibility":["The graph is one labelled group; nodes and edge labels are buttons, and the ordered list is its parallel accessible form.","Every selectable row and control keeps a visible 2px primary outline and a 44px target on touch tiers.","A problem is named in text and marked with an icon, so it is never conveyed by color alone; an unreachable step is dashed and says so.","A conflict or problem is announced as an alert."],"constraints":["Built only from Adapter Widgets (Stack, Text, Button, Badge, Icon, TextInput, Alert, Select, SelectOption, Disclosure, ListItem, SegmentedControl, GraphCanvas); no Widget outside the Adapter catalog.","The graph is the GraphCanvas Widget with explicit column and row positions; the live Workbench derives them from the Flow and never persists them.","Every visible string is bound with $i18n except identities (Flow, View, Variant and Widget names, trigger labels, IDs, requirement references); en-US and zh-TW keep identical key sets.","This View models the page content only; the Workbench shell is shown by the Workbench View.","Visual language follows the Quiet Canvas design system in DESIGN.md."],"decisions":[],"entryConditions":["A person opened a Flow from the UX Flows list (/flows/<flowId>); the base state shows \"Sign in and triage\", the dogfood Workspace's Flow with a return transition, as a graph with nothing selected and no pending changes.","Variants select a step or a transition, open a picker, swap the graph for the Flow that ends (Comment and resolve) or for a Flow with problems, show unsaved edits and a conflict, and switch to the ordered list.","The render context selects one Workspace viewport preset, one Locale and one theme: desktop edits with the inspector beside the canvas, tablet reads the graph with a panel button, and a phone reads the ordered list."],"intent":"Show one UX Flow in the Workbench as built from Adapter Widgets only: the Flow as a node-and-edge graph (or an ordered list) beside a structured inspector for the selected step or transition, with the problems, unsaved-changes and conflict states of editing.","interactionRules":["The graph and the list are two views of one Flow; choosing a step or a transition in either selects the same one in the inspector.","With nothing selected the inspector shows the Flow itself: its name, entry step, counts and requirement references; choosing a step or a transition shows that one, with a back control to the Flow.","A step names its View and Variant and lists its outgoing transitions; adding a transition picks a Widget of the step's View, then one of the Events that Widget declares, then the step it goes to.","The Event picker offers the Events the trigger Widget declares; an existing Event the Widget does not declare stays selected and labelled.","A Flow with problems stays editable: the problems are listed above the canvas, each selecting its step or transition, and an unreachable step stays on the canvas, drawn dashed and marked.","Unsaved edits show a status with Discard and Save and turn Play into a secondary action; a revision conflict keeps the edits and offers to reload the other version.","A step that ends the Flow has no outgoing transition and is marked End on the graph; a cycle is an ordinary return transition."],"references":[{"label":"Phase 5 of the closed loop: dogfood coverage of the four core surfaces","relation":"decision","type":"external","uri":"https://github.com/DevilTea/uiux/discussions/379#discussioncomment-19257377"},{"relation":"opened-from","type":"view","viewId":"f10a5c01-3a6e-4c1d-9b0e-5d1c7e2a4f01"},{"relation":"opens","type":"view","viewId":"f10a5c03-3a6e-4c1d-9b0e-5d1c7e2a4f03"}],"requirements":["01a11544-6358-72ae-95ed-589ac1837f39","01a11544-6270-76ac-939c-2816a124d094","01a18120-fe71-7c8c-a69e-5d74c152cb58","01a116f0-9016-75fb-90ff-ed86412b65a4"]},"variants":{"add-transition":{"state":{"graph":{"selection":"s4"},"inspector-flow":{"visible":false},"inspector-step":{"visible":true},"inspector-step-add-form":{"visible":true},"inspector-step-add-transition":{"visible":false}}},"details-open":{"requirements":["01a18120-fe71-7c8c-a69e-5d74c152cb58"],"state":{"inspector-flow-details":{"open":true}}},"event-picker-open":{"requirements":["01a11544-6386-77b6-aa9f-f767db5deb3c"],"state":{"graph":{"selection":"edge:3"},"inspector-flow":{"visible":false},"inspector-transition":{"visible":true},"inspector-transition-event":{"open":true}}},"flow-ends":{"requirements":["01a11544-6270-76ac-939c-2816a124d094"],"state":{"graph-end":{"visible":true},"graph-main":{"visible":false},"inspector-flow":{"visible":false},"inspector-flow-1":{"visible":true}}},"graph-problems":{"requirements":["01a11544-6244-7a31-b37f-7f775a7d072a","01a11544-629c-7dbf-8e41-36c8e37537b3","01a115cd-3223-7e9e-abc8-a80f2efec2da"],"state":{"graph-broken":{"visible":true},"graph-main":{"visible":false},"graph-problems":{"selection":"s5"},"inspector-flow":{"visible":false},"inspector-step-problem":{"visible":true},"problems-alert":{"visible":true}}},"list-layout":{"state":{"graph-wrap":{"visible":false},"list-wrap":{"visible":true},"list-wrap-phone":{"visible":false},"plist":{"visible":false},"seg-graph":{"selected":false},"seg-list":{"selected":true}}},"step-selected":{"state":{"graph":{"selection":"s4"},"inspector-flow":{"visible":false},"inspector-step":{"visible":true}}},"transition-selected":{"state":{"graph":{"selection":"edge:3"},"inspector-flow":{"visible":false},"inspector-transition":{"visible":true}}},"unsaved-conflict":{"state":{"conflict-alert":{"visible":true},"play":{"variant":"outline"},"unsaved-group":{"visible":true}}},"variant-picker-open":{"state":{"graph":{"selection":"s4"},"inspector-flow":{"visible":false},"inspector-step":{"visible":true},"inspector-step-variant":{"open":true}}}}}

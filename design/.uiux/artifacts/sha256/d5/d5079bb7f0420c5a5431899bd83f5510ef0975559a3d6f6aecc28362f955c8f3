	.properties(p => p
		.titleResult(translatedResult<ThreadRowInterfaces['config']['resolved']>(c => ({ key: c.titleKey, literal: c.title })))
		.title(translatedText<ThreadRowInterfaces['config']['resolved']>(c => ({ key: c.titleKey, literal: c.title })))
